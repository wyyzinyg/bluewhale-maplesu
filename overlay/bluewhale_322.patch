+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.maplesu.core.ui.util
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.security.MessageDigest
+import java.time.Instant
+import java.util.Locale
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+
+/**
+ * A user-requested, offline SU-log evidence snapshot.
+ *
+ * The archive deliberately uses fixed entry names. A log file name or log contents can never
+ * become a ZIP path. Both the unfiltered, already-bounded source snapshot and the currently
+ * visible filter result are retained so a filtered export cannot be mistaken for a full log.
+ */
+object SulogEvidenceArchive {
+    const val FORMAT = "bluewhale-sulog-evidence"
+    const val SCHEMA = 1
+
+    private const val METADATA = "metadata.json"
+    private const val SOURCE = "source.log"
+    private const val FILTERED = "filtered.log"
+    private const val SUMS = "SHA256SUMS.txt"
+    private const val MAX_ENTRY_BYTES = 4 * 1024 * 1024
+    private val ENTRY_NAMES = setOf(METADATA, SOURCE, FILTERED, SUMS)
+
+    data class Request(
+        val sourceName: String,
+        val appVersion: String,
+        val searchText: String,
+        val selectedFilters: Set<SulogEventFilter>,
+        val sourceEntries: List<SulogEntry>,
+        val visibleEntries: List<SulogEntry>,
+        val createdAtEpochMillis: Long = System.currentTimeMillis(),
+    )
+
+    data class Archive(
+        val bytes: ByteArray,
+        val sha256: String,
+        val sourceCount: Int,
+        val visibleCount: Int,
+    )
+
+    data class Verification(
+        val sourceCount: Int,
+        val visibleCount: Int,
+        val sha256: String,
+    )
+
+    fun create(request: Request): Archive {
+        require(request.sourceName.isNotBlank()) { "Missing source log name" }
+        require(request.sourceEntries.size <= 1000) { "Source snapshot exceeds reader bound" }
+        require(request.visibleEntries.size <= request.sourceEntries.size) {
+            "Filtered snapshot cannot contain more rows than its source"
+        }
+
+        val metadata = JSONObject()
+            .put("format", FORMAT)
+            .put("schema", SCHEMA)
+            .put("createdAt", Instant.ofEpochMilli(request.createdAtEpochMillis).toString())
+            .put("appVersion", request.appVersion)
+            .put("sourceFile", request.sourceName)
+            .put("sourceCount", request.sourceEntries.size)
+            .put("visibleCount", request.visibleEntries.size)
+            .put("searchText", request.searchText)
+            .put("selectedFilters", JSONArray(request.selectedFilters.map { it.name }.sorted()))
+            .put("sourceReaderLimit", 1000)
+            .put("note", "source.log is the bounded source snapshot; filtered.log is the current UI filter result")
+            .toString(2) + "\n"
+        val payloads = linkedMapOf(
+            SOURCE to lines(request.sourceEntries),
+            FILTERED to lines(request.visibleEntries),
+        )
+        val sums = payloads.entries.joinToString(separator = "", postfix = "") { (name, bytes) ->
+            "${sha256(bytes)}  $name\n"
+        }
+        val files = linkedMapOf(
+            METADATA to metadata.toByteArray(Charsets.UTF_8),
+            SOURCE to payloads.getValue(SOURCE),
+            FILTERED to payloads.getValue(FILTERED),
+            SUMS to sums.toByteArray(Charsets.US_ASCII),
+        )
+        val output = ByteArrayOutputStream()
+        ZipOutputStream(output).use { zip ->
+            files.forEach { (name, bytes) ->
+                zip.putNextEntry(ZipEntry(name).apply { time = 0L })
+                zip.write(bytes)
+                zip.closeEntry()
+            }
+        }
+        val bytes = output.toByteArray()
+        return Archive(bytes, sha256(bytes), request.sourceEntries.size, request.visibleEntries.size)
+    }
+
+    /** Verify entry set, sizes, per-file hashes and metadata counts after a SAF write/read-back. */
+    fun verify(bytes: ByteArray): Verification {
+        val files = linkedMapOf<String, ByteArray>()
+        ZipInputStream(ByteArrayInputStream(bytes)).use { zip ->
+            while (true) {
+                val entry = zip.nextEntry ?: break
+                check(!entry.isDirectory && entry.name in ENTRY_NAMES) { "Unexpected archive entry" }
+                check(files.put(entry.name, readBounded(zip)) == null) { "Duplicate archive entry" }
+                zip.closeEntry()
+            }
+        }
+        check(files.keys == ENTRY_NAMES) { "Incomplete evidence archive" }
+        val metadata = JSONObject(files.getValue(METADATA).toString(Charsets.UTF_8))
+        check(metadata.optString("format") == FORMAT && metadata.optInt("schema") == SCHEMA) {
+            "Unsupported evidence format"
+        }
+        val sourceCount = metadata.optInt("sourceCount", -1)
+        val visibleCount = metadata.optInt("visibleCount", -1)
+        check(sourceCount in 0..1000 && visibleCount in 0..sourceCount) { "Invalid evidence counts" }
+        val expectedSums = buildString {
+            listOf(SOURCE, FILTERED).forEach { name ->
+                append(sha256(files.getValue(name))).append("  ").append(name).append('\n')
+            }
+        }
+        check(files.getValue(SUMS).toString(Charsets.US_ASCII) == expectedSums) {
+            "Evidence checksum mismatch"
+        }
+        check(countLines(files.getValue(SOURCE)) == sourceCount) { "Source row count mismatch" }
+        check(countLines(files.getValue(FILTERED)) == visibleCount) { "Filtered row count mismatch" }
+        return Verification(sourceCount, visibleCount, sha256(bytes))
+    }
+
+    private fun lines(entries: List<SulogEntry>): ByteArray {
+        if (entries.isEmpty()) return ByteArray(0)
+        return entries.joinToString(separator = "\n", postfix = "\n") { it.rawLine }
+            .toByteArray(Charsets.UTF_8)
+    }
+
+    private fun countLines(bytes: ByteArray): Int {
+        if (bytes.isEmpty()) return 0
+        val text = bytes.toString(Charsets.UTF_8)
+        check(text.endsWith('\n')) { "Log payload is not newline terminated" }
+        return text.dropLast(1).split('\n').size
+    }
+
+    private fun readBounded(input: ZipInputStream): ByteArray {
+        val output = ByteArrayOutputStream()
+        val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+        while (true) {
+            val count = input.read(buffer)
+            if (count < 0) break
+            check(output.size() + count <= MAX_ENTRY_BYTES) { "Archive entry is too large" }
+            output.write(buffer, 0, count)
+        }
+        return output.toByteArray()
+    }
+
+    internal fun sha256(bytes: ByteArray): String = MessageDigest.getInstance("SHA-256")
+        .digest(bytes)
+        .joinToString(separator = "") { "%02x".format(Locale.US, it) }
+}
