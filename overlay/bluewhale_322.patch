+    /** Export only after the user picks a destination; verify the exact bytes read back from SAF. */
+    fun export(context: Context, uri: Uri) {
+        val snapshot = _uiState.value
+        if (snapshot.isLoading || snapshot.isExporting) return
+        val source = snapshot.files.firstOrNull { it.path == snapshot.selectedFilePath } ?: return
+        _uiState.update { it.copy(isExporting = true, exportEvent = null) }
+        val applicationContext = context.applicationContext
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val archive = SulogEvidenceArchive.create(
+                    SulogEvidenceArchive.Request(
+                        sourceName = source.name,
+                        appVersion = BuildConfig.VERSION_NAME,
+                        searchText = snapshot.searchText,
+                        selectedFilters = snapshot.selectedFilters,
+                        sourceEntries = snapshot.entries,
+                        visibleEntries = snapshot.visibleEntries,
+                    )
+                )
+                val resolver = applicationContext.contentResolver
+                resolver.openOutputStream(uri, "wt")?.use { it.write(archive.bytes) }
+                    ?: throw IllegalStateException("Cannot open export destination")
+                val readBack = resolver.openInputStream(uri)?.use { it.readBytes() }
+                    ?: throw IllegalStateException("Cannot read back export destination")
+                check(readBack.contentEquals(archive.bytes)) { "Export read-back differs" }
+                val verification = SulogEvidenceArchive.verify(readBack)
+                check(verification.sha256 == archive.sha256) { "Export digest differs" }
+                val eventId = ++exportEventId
+                _uiState.update {
+                    it.copy(
+                        isExporting = false,
+                        exportEvent = SulogExportEvent(
+                            id = eventId,
+                            succeeded = true,
+                            visibleCount = verification.visibleCount,
+                            sha256 = verification.sha256,
+                        ),
+                    )
+                }
+            } catch (cancelled: kotlinx.coroutines.CancellationException) {
+                _uiState.update { it.copy(isExporting = false) }
+                throw cancelled
+            } catch (error: Exception) {
+                Log.w("SulogViewModel", "Evidence export failed", error)
+                val eventId = ++exportEventId
+                _uiState.update {
+                    it.copy(
+                        isExporting = false,
+                        exportEvent = SulogExportEvent(id = eventId, succeeded = false),
+                    )
+                }
+            }
+        }
+    }
+
+    fun consumeExportEvent() {
+        _uiState.update { it.copy(exportEvent = null) }
+    }
