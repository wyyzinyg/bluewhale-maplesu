+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.maplesu.core.ui.util
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+
+class SulogEvidenceArchiveTest {
+    private fun entry(raw: String) = parseSulogLine(
+        line = raw,
+        currentTimeMillis = 1_700_000_000_000L,
+        uptimeMillis = 1_000L,
+    )
+
+    private val first = entry("type=root_execve seq=1 uid=10001 comm=sh argv=\"id -u\" retval=0")
+    private val second = entry("type=sucompat seq=2 uid=10002 comm=蓝鱼 argv=\"测试\" retval=1")
+
+    private fun request(
+        source: List<SulogEntry>,
+        visible: List<SulogEntry>,
+        query: String = "",
+        filters: Set<SulogEventFilter> = defaultSulogEventFilters(),
+    ) = SulogEvidenceArchive.Request(
+        sourceName = "sulog-2026-11-27.log",
+        appVersion = "3.21.0-bw",
+        searchText = query,
+        selectedFilters = filters,
+        sourceEntries = source,
+        visibleEntries = visible,
+        createdAtEpochMillis = 0L,
+    )
+
+    @Test
+    fun archiveRoundTripRetainsSourceAndFilteredSnapshots() {
+        val archive = SulogEvidenceArchive.create(
+            request(
+                source = listOf(first, second),
+                visible = listOf(second),
+                query = "10002",
+                filters = setOf(SulogEventFilter.SuCompat),
+            )
+        )
+        val verified = SulogEvidenceArchive.verify(archive.bytes)
+        assertEquals(2, verified.sourceCount)
+        assertEquals(1, verified.visibleCount)
+        assertEquals(archive.sha256, verified.sha256)
+        assertTrue(archive.sha256.matches(Regex("[0-9a-f]{64}")))
+    }
+
+    @Test
+    fun emptyFilterResultIsVerifiableAndDoesNotEraseSource() {
+        val archive = SulogEvidenceArchive.create(
+            request(listOf(first), emptyList(), "no-match", emptySet())
+        )
+        assertEquals(1, archive.sourceCount)
+        assertEquals(0, archive.visibleCount)
+        assertEquals(0, SulogEvidenceArchive.verify(archive.bytes).visibleCount)
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun tamperingWithPayloadFailsChecksumVerification() {
+        val archive = SulogEvidenceArchive.create(request(listOf(first), listOf(first)))
+        val files = linkedMapOf<String, ByteArray>()
+        ZipInputStream(ByteArrayInputStream(archive.bytes)).use { zip ->
+            while (true) {
+                val entry = zip.nextEntry ?: break
+                files[entry.name] = zip.readBytes()
+            }
+        }
+        files["source.log"] = files.getValue("source.log").toString(Charsets.UTF_8)
+            .replace("uid=10001", "uid=10003").toByteArray(Charsets.UTF_8)
+        val output = ByteArrayOutputStream()
+        ZipOutputStream(output).use { zip ->
+            files.forEach { (name, bytes) ->
+                zip.putNextEntry(ZipEntry(name))
+                zip.write(bytes)
+                zip.closeEntry()
+            }
+        }
+        SulogEvidenceArchive.verify(output.toByteArray())
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun archiveCannotSmuggleUnexpectedPaths() {
+        val output = ByteArrayOutputStream()
+        ZipOutputStream(output).use { zip ->
+            zip.putNextEntry(ZipEntry("../../outside"))
+            zip.write(1)
+            zip.closeEntry()
+        }
+        SulogEvidenceArchive.verify(output.toByteArray())
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun visibleSnapshotCannotExceedSourceSnapshot() {
+        SulogEvidenceArchive.create(request(emptyList(), listOf(first), filters = emptySet()))
+    }
+}
